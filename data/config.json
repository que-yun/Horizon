{
  "version": "1.0",
  "ai": {
    "provider": "openai",
    "model": "gpt-5.6-terra",
    "base_url": "http://127.0.0.1:15721/v1",
    "api_key_env": "OPENAI_API_KEY",
    "temperature": 0.2,
    "max_tokens": 8192,
    "languages": [
      "zh"
    ]
